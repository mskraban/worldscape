{
  "name": "worldscape",
  "version": "1.0.0",
  "description": "Invent a tiny country from one word: map, flag, coat of arms, language, history and a playable anthem. Deterministic, offline, printable as a poster.",
  "scripts": {
    "build": "node scripts/build-engine.js",
    "test": "node --test",
    "dev": "node scripts/dev-server.js",
    "assets": "node scripts/make-assets.js",
    "docs": "node scripts/build-docs.js",
    "freeze": "node scripts/freeze-signatures.js"
  },
  "keywords": [
    "worldbuilding",
    "map-generator",
    "procedural-generation",
    "fantasy-map",
    "tabletop-rpg",
    "flag",
    "heraldry",
    "conlang",
    "generative",
    "api",
    "vercel",
    "seed"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-music": "^5.3.0"
  },
  "private": false,
  "engines": {
    "node": ">=20"
  }
}
